# From developer.x.com -> your app "rozpost" -> Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Date of Day 1, in YYYY-MM-DD. Set once, never change it again.
START_DATE=

# Everything below has sane defaults; override only if you want to.
TIMEZONE=America/New_York
POST_AT=11:11
MEDIA_PATH=It gets easier final.mp4
TEXT_TEMPLATE=Day {n}
